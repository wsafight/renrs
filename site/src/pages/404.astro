---
import Base from '../layouts/Base.astro';
import BracketLink from '../components/BracketLink.astro';
import T from '../components/T.astro';
import {href} from '../catalog';
import {pagesMeta} from '../i18n';
import '../styles/home.css';
---
<Base title={pagesMeta.notFound.title.en} titleZh={pagesMeta.notFound.title.zh} description={pagesMeta.notFound.description.en} descriptionZh={pagesMeta.notFound.description.zh}>
  <main id="main-content" class="dark-section" style="min-height:70svh;display:grid;place-items:center;padding:120px 20px 80px">
    <div class="section-inner" style="text-align:center">
      <p class="eyebrow">404</p>
      <h1 class="hero-title"><T en="This route does not exist" zh="没有这条路线" /></h1>
      <p class="section-lede" style="margin:24px auto 32px;color:#e7e2d8a3"><T en="The page is missing, or the docs URL has moved." zh="请求的页面不存在，或已经换到新的文档地址。" /></p>
      <BracketLink href={href()}><T en="Back to home" zh="返回首页" /></BracketLink>
    </div>
  </main>
</Base>
