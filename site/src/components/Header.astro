---
import Search from '@lucide/astro/icons/search';
import Sun from '@lucide/astro/icons/sun';
import Moon from '@lucide/astro/icons/moon';
import BrandMark from './BrandMark.astro';
import BracketLink from './BracketLink.astro';
import T from './T.astro';
import {href} from '../catalog';
import {githubRepo, ui} from '../i18n';

interface Props {
  home?: boolean;
}
const {home = false} = Astro.props;
const docsHref = href('docs');
const startHref = href('start/quickstart');
const homeHref = href();
const nav = [
  {href: `${homeHref}#capabilities`, en: ui.en.capabilities, zh: ui.zh.capabilities, current: false},
  {href: `${homeHref}#script`, en: ui.en.script, zh: ui.zh.script, current: false},
  {href: `${homeHref}#tools`, en: ui.en.tools, zh: ui.zh.tools, current: false},
  {href: `${homeHref}#ship`, en: ui.en.ship, zh: ui.zh.ship, current: false},
  {href: docsHref, en: ui.en.docs, zh: ui.zh.docs, current: !home, external: false},
  {href: githubRepo, en: ui.en.github, zh: ui.zh.github, current: false, external: true},
];
---
<a class="skip-link" href="#main-content"><T en={ui.en.skip} zh={ui.zh.skip} /></a>
<header class="site-header" id="site-header" data-header-theme={home ? 'dark' : undefined}>
  <div class="site-header-inner">
    <a class="brand-link" href={homeHref} aria-label={ui.en.home} data-i18n-aria="home">
      <BrandMark />
      <span class="brand-name">RenRS</span>
    </a>
    <nav class="desktop-nav" aria-label={ui.en.primaryNav} data-i18n-aria="primaryNav">
      {nav.map(item => (
        <a href={item.href} aria-current={item.current ? 'page' : undefined} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}><T en={item.en} zh={item.zh} /></a>
      ))}
      <span class="nav-indicator" aria-hidden="true"></span>
    </nav>
    <div class="header-actions">
      <button class="icon-button" type="button" data-search-open aria-haspopup="dialog" aria-controls="search-dialog" aria-label={ui.en.search} data-i18n-aria="search">
        <Search size={18} stroke-width={1.75} />
      </button>
      <button class="icon-button" type="button" data-theme-toggle aria-label={ui.en.theme} data-i18n-aria="theme">
        <Sun class="icon-sun" size={18} stroke-width={1.75} />
        <Moon class="icon-moon" size={18} stroke-width={1.75} />
      </button>
      <button class="icon-button language-toggle" type="button" data-lang-toggle aria-label={ui.en.lang} data-i18n-aria="lang">
        <span class="i18n-en">中文</span>
        <span class="i18n-zh">EN</span>
      </button>
      <BracketLink class="bracket-link-small" href={startHref}><T en={ui.en.quickStart} zh={ui.zh.quickStart} /></BracketLink>
      <button class="menu-toggle" id="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={ui.en.menuOpen} data-i18n-aria="menuOpen">
        <span></span><span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>
<div class="mobile-menu" id="mobile-menu" aria-hidden="true">
  <nav aria-label={ui.en.mobileNav} data-i18n-aria="mobileNav">
    {nav.map(item => (
      <a href={item.href} target={item.external ? '_blank' : undefined} rel={item.external ? 'noopener noreferrer' : undefined}><T en={item.en} zh={item.zh} /></a>
    ))}
    <a href={startHref}><T en={ui.en.quickStart} zh={ui.zh.quickStart} /></a>
  </nav>
</div>
