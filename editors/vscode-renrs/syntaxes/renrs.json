{
  "scopeName": "source.renrs",
  "patterns": [
    { "name": "comment.line.number-sign.renrs", "match": "#.*$" },
    { "name": "string.quoted.double.renrs", "begin": "\"", "end": "\"", "patterns": [{ "name": "constant.character.escape.renrs", "match": "\\\\." }, { "name": "variable.other.renrs", "match": "\\{[^}]+\\}" }] },
    { "name": "keyword.control.renrs", "match": "\\b(config|define|default|image|layer|order|label|menu|if|elif|else|jump|call|return|set|extend|scene|show|hide|clear|move|transform|timeline|parallel|nvl|transition|video|voice|play|queue|stop|pause|with|at|as|zorder|onlayer|over|alias|loop|fadein|fadeout|volume)\\b|@id\\b" },
    { "name": "support.function.renrs", "match": "\\b(list|record|get|put|push|remove|len|contains)(?=\\s*\\()" },
    { "name": "constant.language.renrs", "match": "\\b(true|false)\\b" },
    { "name": "constant.numeric.renrs", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" }
  ]
}
