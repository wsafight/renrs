{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [{ "open": "\"", "close": "\"", "notIn": ["string"] }, { "open": "(", "close": ")" }],
  "indentationRules": { "increaseIndentPattern": ":\\s*(#.*)?$", "decreaseIndentPattern": "^\\s*(elif|else)\\b" }
}
